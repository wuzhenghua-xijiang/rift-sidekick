{
  "name": "rift-sidekick",
  "version": "0.2.5",
  "private": true,
  "description": "A playful Windows companion for League of Legends champion select.",
  "author": "Rift Sidekick contributors",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run voices:check && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "voices:generate": "python3 scripts/generate-combat-voices.py",
    "voices:check": "node scripts/check-combat-voices.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.riftsidekick.desktop",
    "productName": "Rift Sidekick",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "THIRD-PARTY-NOTICES.txt",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "tray.ico"
      },
      {
        "from": "resources/combat-voices",
        "to": "combat-voices",
        "filter": [
          "*.mp3",
          "manifest.json"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Rift-Sidekick-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://gh-proxy.com/https://github.com/wuzhenghua-xijiang/rift-sidekick/releases/latest/download/"
      }
    ]
  }
}
